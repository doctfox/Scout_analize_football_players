# Шаблон настроек. Скопируйте в settings.env (start.bat сделает это сам при первом запуске) и поменяйте пароли.
# Настройки запуска. start.bat загружает их в окружение, docker-compose.yml берёт оттуда
# (без start.bat действуют такие же значения по умолчанию из docker-compose.yml)

# PostgreSQL (контейнер scout-db). С компьютера/DBeaver: localhost:DB_PORT
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=project_futbol
DB_PORT=5433

# Порт transfermarkt-api на компьютере (Swagger: http://localhost:8000/docs)
TM_PORT=8000

# Сезоны (год начала: 2021 -> 2021/22). auto = с FIRST_SEASON по текущий: новый сезон подхватится сам.
# Можно перечислить вручную: SEASONS=2024,2025
SEASONS=auto
FIRST_SEASON=2021
# Сколько дней доверять кэшу Transfermarkt для текущего сезона (составы и стоимости меняются)
TM_CURRENT_TTL_DAYS=7

# Откуда брать клубы/игроков/составы Transfermarkt:
#   auto    - из открытого набора transfermarkt-datasets (без запросов к сайту), а чего там ещё нет
#             (обычно текущий сезон) - через transfermarkt-api (парсит сайт, возможны блокировки)
#   dataset - только набор, сайт не трогается никогда (текущий сезон появится после обновления набора)
#   api     - всё через transfermarkt-api, как раньше
TM_SOURCE=auto

# Какие лиги собирать (через запятую). Весь каталог: start.bat leagues
LEAGUES=ENG-Premier League,ESP-La Liga,GER-Bundesliga,ITA-Serie A,FRA-Ligue 1,RUS-Premier League,NED-Eredivisie,POR-Liga Portugal

# Параллельных запросов к transfermarkt-api
TM_WORKERS=1

# Пауза между запросами к Transfermarkt, сек (при 403 увеличьте до 4-5)
TM_DELAY=3

# Tor: 1 - все запросы к Transfermarkt (и tm-api, и трансферы) идут через Tor,
# при 403 парсер меняет выходной IP вместо паузы 5-30 мин. 0 - напрямую.
USE_TOR=1
# Пароль управляющего порта Tor (порт наружу не открыт, можно не менять)
TOR_CONTROL_PASSWORD=change_me
# Пауза после смены IP, сек, и сколько раз подряд менять IP, прежде чем взять паузу 5 мин
TOR_ROTATE_PAUSE=15
TOR_ROTATIONS_BEFORE_PAUSE=10
